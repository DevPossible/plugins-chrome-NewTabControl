{
  "manifest_version": 3,
  "name": "New Tab Control",
  "version": "0.1.0",
  "description": "Take control of your new tab page. Point it at the DevPossible Start Page, or any page you choose.",
  "homepage_url": "https://devpossible.com/",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "chrome_url_overrides": {
    "newtab": "newtab/newtab.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "New Tab Control settings",
    "default_popup": "options/options.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
